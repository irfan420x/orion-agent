# systemd/oriond.service — LIVE system unit for the Orion daemon on
# this VM/container (NOT the shipped user unit: the shipped unit is
# the repo-root oriond.service, installed by ./install.sh --systemd
# to ~/.config/systemd/user/). This file is the live copy kept in
# the repo under systemd/ so the drift-guard test
# (TestShippedUnitRestartsOnCleanExit, cmd/oriond/rc22_teama_test.go)
# can verify the live unit agrees with the shipped unit on
# Restart/StartLimitBurst in a clean checkout (F-A17-1, rc23).
#
# Restart policy (F-A17-2, rc23 — supersedes the rc22
# Restart=always rule): Restart=on-failure +
# RestartForceExitStatus=42 — /restart exits 42, and a clean exit 0
# (SIGTERM shutdown) no longer restarts. The burst limit
# (StartLimitBurst=12 in 60s) is unchanged: RestartForceExitStatus
# does NOT bypass it, by design.
#
# Log path: StandardOutput/StandardError append to oriond-live.log —
# a STABLE path with no date in the name, so a fresh install does
# not need a new filename every day (the previous dated name,
# oriond-live-2026-11-14.log, would go stale on the next install;
# rotate the stable file with logrotate or by hand instead).
#
# Proxy: the HTTP(S)_PROXY values are a credential-free egress
# hostname — no secret is stored in this file. Never add a token
# or API key here; the Telegram token and provider keys live only
# in ~/.orion/config.json (0600).
#
# Hardening (F-A17-18, rc23): NoNewPrivileges, ProtectSystem=true,
# PrivateTmp. ProtectSystem=true — NOT strict/full: the daemon's data
# dir (~/.orion) and working directory both live under /home, and
# ProtectSystem=strict would make /home read-only and break the
# daemon; ProtectSystem=true leaves /home writable while making
# /usr, /boot and /etc read-only, which oriond never needs to
# write. Likewise ProtectHome must NOT be added: the data dir is
# in $HOME.
# NO CapabilityBoundingSet — DELIBERATELY OMITTED (rc23, verified
# 2026-11-14): any restriction of the bounding set breaks the
# sandbox. The sandbox runs every shell_exec via `unshare --user
# --map-root-user`, whose uid_map write needs effective CAP_SETUID
# at exec; systemd clears the effective set for non-file-caps
# binaries, so an empty bounding set AND CapabilityBoundingSet=
# CAP_SETUID CAP_SETGID AND CAP_SYS_ADMIN AND the same plus
# AmbientCapabilities=CAP_SETUID CAP_SETGID ALL fail with
# "unshare: write failed /proc/self/uid_map: Operation not
# permitted" (matrix of 9 scratch oneshot units). Dropping the
# bounding set would silently break every sandboxed tool call on
# this root-run unit, so the directive is left out rather than
# applied blindly. The three applied directives were each verified
# not to break the sandbox path (matrix) and the daemon was
# started and stopped cleanly under exactly this set (banner
# @TestBot, polling, SIGTERM shutdown exit 0).
# Verified 2026-11-14 (rc23): systemd-analyze verify clean, and
# the daemon starts and polls under these directives (transient
# systemd unit, scratch HOME, fake Bot API).
# No watchdog (WatchdogSec): needs sd_notify support in oriond,
# future work — see the shipped unit's header.

[Unit]
Description=Orion daemon (Telegram + CLI OS agent)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=12

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/orion-go
ExecStart=/home/hatch/workspace/orion-go/bin/oriond
Environment=HOME=/home/hatch
Environment=HTTP_PROXY=http://hatch-egress-proxy:3128
Environment=HTTPS_PROXY=http://hatch-egress-proxy:3128
Environment=http_proxy=http://hatch-egress-proxy:3128
Environment=https_proxy=http://hatch-egress-proxy:3128
Environment=ALL_PROXY=http://hatch-egress-proxy:3128
Environment=all_proxy=http://hatch-egress-proxy:3128
Environment=NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]
Environment=no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]
Restart=on-failure
RestartSec=5s
RestartForceExitStatus=42
# F-A17-18: harden the daemon (network-facing, executes tools).
# ProtectSystem=true, not strict: /home must stay writable (data
# dir + working directory). Do NOT add ProtectHome, and do NOT add
# CapabilityBoundingSet: any restriction breaks the sandbox's
# `unshare --user --map-root-user` uid_map write (see header).
NoNewPrivileges=true
ProtectSystem=true
PrivateTmp=true
StandardOutput=append:/home/hatch/workspace/orion-go/oriond-live.log
StandardError=append:/home/hatch/workspace/orion-go/oriond-live.log

[Install]
WantedBy=multi-user.target
