# oriond.service — systemd user unit for the Orion daemon.
#
# The daemon serves the Telegram gateway (polling) until interrupted.
# It needs a Telegram bot token: set telegram_token in
# ~/.orion/config.json or ORION_TELEGRAM_TOKEN in the environment
# (never put the token in this file).
#
# Install:
#   ./install.sh --systemd
#     — installs this unit to ~/.config/systemd/user/oriond.service,
#       rewriting ExecStart to the binary install.sh actually used,
#       and enables it when a user systemd instance is reachable.
#
#   ... or by hand:
#   mkdir -p ~/.config/systemd/user
#   cp oriond.service ~/.config/systemd/user/
#   # If oriond lives in /usr/local/bin instead of ~/.local/bin,
#   # change ExecStart below to /usr/local/bin/oriond first.
#   systemctl --user daemon-reload
#   systemctl --user enable --now oriond
#
# Manage:
#   systemctl --user status oriond
#   systemctl --user restart oriond
#   systemctl --user stop oriond
#   journalctl --user -u oriond -f
#
# Notes:
# - Runs as a user unit (no root needed); oriond reads its config
#   from ~/.orion/config.json.
# - Restart=on-failure + RestartForceExitStatus=42 (F-A17-2, rc23 —
#   supersedes the F-A16-1 Restart=always rule): /restart now exits
#   42 (exitRestartRequested), NOT 0, and the unit restarts exit 42
#   explicitly. A clean exit 0 (SIGTERM shutdown) no longer restarts
#   — only a fault or an explicit restart request does — so an
#   operator's /restart can no longer burn the start-limit burst the
#   way a clean exit did under Restart=always, when every exit
#   counted identically toward the burst. An explicit
#   `systemctl --user stop` still stops it (a requested stop is
#   not a restart trigger). RestartForceExitStatus does NOT bypass
#   StartLimitBurst — the burst stays the circuit breaker for
#   genuine faults, by design. RestartSec=5s avoids a tight loop if
#   the token or provider config is wrong — fix the config and
#   restart with `systemctl --user restart oriond`.
#   This fixes the /restart-kills-the-daemon bug (F-A16-1); it does
#   NOT explain the 2026-11-14 ~06:19 silent death (no "restart
#   requested" line in that day's daemon log, and the owner was
#   asleep), which remains unattributed.
# - StartLimitBurst=12 in 60s (F-A16-6): give up (and surface the
#   failure) instead of restarting forever on a persistent fault
#   such as a revoked token; systemd stops trying until the unit
#   is reset (`systemctl --user reset-failed oriond`) or started
#   by hand. 12 matches the live unit (systemd/oriond.service).
# - Linger (F-A16-6): install.sh --systemd runs
#   `loginctl enable-linger $USER`, so the unit starts at boot
#   and survives logout. Without linger a user unit stops on
#   logout and does not start at boot until the user logs in.
# - No watchdog (WatchdogSec, F-A16-6): a real watchdog needs
#   sd_notify support in the daemon, which oriond does not have
#   yet — future work, not a unit-file flag.
# - Boot recovery is UNTESTED on this VM (no safe way to trigger
#   a reboot there): the first boot after a laptop install should
#   be checked with `systemctl --user status oriond`.

[Unit]
Description=Orion daemon — model-agnostic OS agent (Telegram gateway)
Documentation=https://github.com/irfan420x/orion-agent
After=network-online.target
Wants=network-online.target
# Give up (and surface the failure) instead of restarting forever on
# a persistent fault such as a revoked token: 12 restarts in 60s, then
# systemd stops trying until the unit is reset/started by hand.
StartLimitIntervalSec=60s
StartLimitBurst=12

[Service]
Type=simple
ExecStart=%h/.local/bin/oriond
WorkingDirectory=%h
Restart=on-failure
RestartSec=5s
RestartForceExitStatus=42

[Install]
WantedBy=default.target
